const inW = $('#in-w'), inH = $('#in-h');

function renderStatic(){
  for(const key of Object.keys(TYPES)){
    const lab = $(`.opt[data-type="${key}"] .opt-sub`);
    if(lab) lab.textContent = `от ${fmt(TYPES[key].rate)} ₽/м²`;
    const from = $(`[data-from="${key}"]`);
    if(from) from.textContent = `от ${fmt(TYPES[key].rate)} ₽ за м²`;
  }
  for(const key of Object.keys(COLORS)){
    const c = COLORS[key];
    const el = $(`.opt[data-color="${key}"]`);
    $('.sw-bar', el).style.backgroundColor = c.hex;
    $('.opt-sub', el).textContent = c.k > 1 ? `${c.ral}, +${Math.round((c.k-1)*100)} %` : c.ral;
  }
}

function render(){
  const it = current();
  const t = TYPES[it.type], c = COLORS[it.color];
  const p = calc(it);

  $('#stage-art').innerHTML = drawNet(it, OPT_MAIN, `${titleOf(it)}, цвет ${c.name}`);
  $('#chip-type').textContent = t.name;
  $('#chip-dot').style.backgroundColor = c.hex;
  $('#chip-color').textContent = `${c.name} ${c.ral}`;
  $('#chip-fast').textContent = cap(FASTENERS[it.fastener].short);
  $('#chip-install').hidden = !it.install;
  $('#stage-area').textContent = `${area2(p.area)} м²`;

  // иконки типов в цвете выбранного профиля
  for(const key of Object.keys(TYPES)){
    const box = $(`.opt[data-type="${key}"] .opt-icon`);
    box.innerHTML = drawNet({ type:key, w:TYPES[key].thumb[0], h:TYPES[key].thumb[1], color:it.color, fastener:it.fastener }, OPT_ICON);
  }
  for(const el of $$('[data-art]')){
    const key = el.dataset.art;
    el.innerHTML = drawNet({ type:key, w:TYPES[key].thumb[0], h:TYPES[key].thumb[1], color:it.color, fastener:it.fastener }, OPT_ART, TYPES[key].name);
  }

  // подсказки по размеру
  const hint = $('#size-hint');
  const bad = !it.wOk || !it.hOk;
  hint.textContent = `Для ${t.full}: ширина ${fmt(t.w[0])}–${fmt(t.w[1])} мм, высота ${fmt(t.h[0])}–${fmt(t.h[1])} мм.`
    + (bad ? ` Считаем по ${fmt(it.w)} × ${fmt(it.h)} мм.` : '');
  hint.classList.toggle('warn', bad);
  $('#box-w').classList.toggle('warn', !it.wOk);
  $('#box-h').classList.toggle('warn', !it.hOk);
  $('#size-tip').textContent = t.tip;
  $('#area-note').textContent = `Площадь ${area2(p.area)} м²`;

  // выбранные карточки
  for(const inp of $$('.opt input')) inp.closest('.opt').classList.toggle('on', inp.checked);

  $('#metal-sub').textContent = `Прочнее, +${rub(t.metal)}`;
  $('#install-sub').textContent = `+${rub(t.install)} за сетку, мастер приедет в удобный день`;

  // цена
  $('#qty-out').textContent = it.qty;
  $('#price-total').textContent = rub(p.total);
  $('#price-unit').textContent = it.qty > 1 ? `${rub(p.unit)} за 1 шт.` : 'за 1 шт.';
  const kTxt = c.k > 1 ? `, цвет +${Math.round((c.k-1)*100)} %` : '';
  const netLabel = p.minApplied
    ? `Сетка, считаем мин. ${area2(t.minArea)} м²${kTxt}`
    : `Сетка, ${area2(p.area)} м² × ${fmt(t.rate)} ₽${kTxt}`;
  const rows = [
    [netLabel, rub(p.net)],
    ['Крепёж', p.fast ? rub(p.fast) : 'входит в цену'],
    ['Установка', p.inst ? rub(p.inst) : 'не нужна']
  ];
  $('#breakdown').innerHTML = rows.map(([a,b]) => `<div><dt>${a}</dt><dd>${b}</dd></div>`).join('');

  $('#mbar-label').textContent = it.qty > 1 ? `${t.name}, ${it.qty} шт.` : t.name;
  $('#mbar-price').textContent = rub(p.total);
}

