  graphite: { name:'Графит',     ral:'RAL 7024', hex:'#45484E', k:1.10 },
  brown:    { name:'Коричневый', ral:'RAL 8017', hex:'#4B3129', k:1.10 },
  white:    { name:'Белый',      ral:'RAL 9016', hex:'#F1F0EB', k:1.00 }
};
const FASTENERS = {
  plastic: { name:'Пластиковый',   short:'пластиковый крепёж' },
  metal:   { name:'Металлический', short:'металлический крепёж' }
