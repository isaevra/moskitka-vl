      const p = calc(i);
      return `<div class="order-item" data-id="${i.id}">
        <div class="oi-thumb">${drawNet(i, OPT_THUMB)}</div>
        <div><div class="oi-title">${titleOf(i)}</div><div class="oi-sub">${subOf(i)}</div></div>
        <div class="oi-side">
          <span class="oi-price">${rub(p.total)}</span>
          <div class="oi-ctrl">
            <div class="stepper sm" role="group" aria-label="Количество">
              <button type="button" data-act="dec" aria-label="Меньше">−</button>
              <output>${i.qty}</output>
              <button type="button" data-act="inc" aria-label="Больше">+</button>
            </div>
            <button type="button" class="icon-btn" data-act="remove" aria-label="Удалить позицию">
              <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            </button>
          </div>
        </div>
      </div>`;
    }).join('')}</div>
    <div class="order-total"><span>Итого, ${count} шт.</span><strong>${rub(total)}</strong></div>`;
  }
  const mo = $('#mbar-order');
  mo.hidden = !order.length;
  mo.textContent = `Заказ (${order.length})`;
  $('#submit-btn').disabled = false;
  updateAddressNote();
  saveOrder();
}

$('#order-box').addEventListener('click', e => {
  const btn = e.target.closest('[data-act]');
  if(!btn) return;
  const row = btn.closest('.order-item');
  const idx = order.findIndex(i => i.id === row.dataset.id);
  if(idx < 0) return;
  const act = btn.dataset.act;
  if(act === 'inc') order[idx].qty = Math.min(50, order[idx].qty + 1);
  if(act === 'dec') order[idx].qty = Math.max(1, order[idx].qty - 1);
  if(act === 'remove') order.splice(idx, 1);
  renderOrder();
});

function addToOrder(){
  const it = current();
  if(!it.wOk || !it.hOk){ state.w = String(it.w); state.h = String(it.h); inW.value = it.w; inH.value = it.h; }
  order.push({
    id: Date.now().toString(36) + Math.random().toString(36).slice(2,6),
    type:it.type, w:it.w, h:it.h, color:it.color, fastener:it.fastener, install:it.install, qty:it.qty
  });
  // если форма уже показывала успех, вернуть форму
  if(!$('#success').hidden) resetForm();
  renderOrder();
  render();
  toast(`Добавлено в заказ: ${titleOf(it)}`);
  const mo = $('#mbar-order');
  mo.classList.remove('bump'); void mo.offsetWidth; mo.classList.add('bump');
}

let toastTimer;
function toast(msg){
  const t = $('#toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove('show'), 2600);
}

/* ===== События конструктора ===== */
function setType(key){
  state.type = key;
  const t = TYPES[key];
  const w = parseInt(state.w,10), h = parseInt(state.h,10);
  if(!(w >= t.w[0] && w <= t.w[1]) || !(h >= t.h[0] && h <= t.h[1])){
    state.w = String(t.def[0]); state.h = String(t.def[1]);
    inW.value = t.def[0]; inH.value = t.def[1];
  }
  const radio = $(`#type-${key}`);
  if(radio) radio.checked = true;
  render();
}

$('#config-form').addEventListener('submit', e => e.preventDefault());
$('#config-form').addEventListener('change', e => {
  const el = e.target;
  if(el.name === 'type') setType(el.value);
  else if(el.name === 'color'){ state.color = el.value; render(); }
  else if(el.name === 'fastener'){ state.fastener = el.value; render(); }
  else if(el.id === 'in-install'){ state.install = el.checked; render(); }
});
for(const inp of $$('.opt input')){
  inp.addEventListener('focus', () => { if(inp.matches(':focus-visible')) inp.closest('.opt').classList.add('focus'); });
  inp.addEventListener('blur', () => inp.closest('.opt').classList.remove('focus'));
}
function onSize(inp, key){
  inp.addEventListener('input', () => {
    const v = digits(inp.value).slice(0,4);
    if(inp.value !== v) inp.value = v;
    state[key] = v;
    render();
  });
  inp.addEventListener('blur', () => {
    const it = current();
    const v = key === 'w' ? it.w : it.h;
    state[key] = String(v); inp.value = v;
    render();
  });
}
onSize(inW, 'w'); onSize(inH, 'h');

$('#qty-dec').addEventListener('click', () => { state.qty = Math.max(1, state.qty-1); render(); });
$('#qty-inc').addEventListener('click', () => { state.qty = Math.min(50, state.qty+1); render(); });
$('#add-btn').addEventListener('click', addToOrder);
$('#mbar-add').addEventListener('click', addToOrder);

for(const b of $$('[data-pick]')){
  b.addEventListener('click', () => {
    setType(b.dataset.pick);
    $('#konstruktor').scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block:'start' });
  });
}

/* ===== Форма заявки ===== */
const fName = $('#f-name'), fPhone = $('#f-phone'), fAddr = $('#f-address'), fComment = $('#f-comment'), fZamer = $('#f-zamer');

function addressRequired(){ return fZamer.checked || order.some(i => i.install); }
function updateAddressNote(){
  $('#addr-note').textContent = addressRequired() ? '(нужен для замера и установки)' : '(для доставки, по желанию)';
}
fZamer.addEventListener('change', updateAddressNote);

function fmtPhone(v){
  let d = digits(v);
  if(!d) return '';
  if(d[0] === '8') d = '7' + d.slice(1);
  if(d[0] !== '7') d = '7' + d;
  d = d.slice(0, 11);
  let out = '+7';
  if(d.length > 1) out += ' (' + d.slice(1, 4);
  if(d.length >= 4) out += ')';
  if(d.length > 4) out += ' ' + d.slice(4, 7);
  if(d.length > 7) out += '-' + d.slice(7, 9);
  if(d.length > 9) out += '-' + d.slice(9, 11);
  return out;
}
fPhone.addEventListener('input', e => {
  if(e.inputType && e.inputType.startsWith('delete')) return;
  fPhone.value = fmtPhone(fPhone.value);
});
fPhone.addEventListener('blur', () => { if(fPhone.value) fPhone.value = fmtPhone(fPhone.value); });

function setErr(input, errEl, msg){
  input.classList.toggle('bad', !!msg);
  errEl.hidden = !msg;
  errEl.textContent = msg || '';
  if(msg) input.setAttribute('aria-invalid','true'); else input.removeAttribute('aria-invalid');
}
for(const [inp, err] of [[fName,'#e-name'],[fPhone,'#e-phone'],[fAddr,'#e-address']]){
  inp.addEventListener('input', () => setErr(inp, $(err), ''));
}

function orderNumber(){
  const d = new Date();
  const pad = n => String(n).padStart(2,'0');
  return `С-${pad(d.getDate())}${pad(d.getMonth()+1)}-${Math.floor(100 + Math.random()*900)}`;
}

function summaryText(p){
  const lines = [`Заявка ${p.number} на москитные сетки`, ''];
  p.items.forEach((i, n) => {
    lines.push(`${n+1}. ${titleOf(i)}`);
    lines.push(`   ${subOf(i)}`);
    lines.push(`   ${i.qty} шт. × ${rub(i.unit)} = ${rub(i.total)}`);
  });
  lines.push('', `Итого: ${rub(p.total)} (предварительно)`, '');
  lines.push(`Имя: ${p.customer.name}`);
  lines.push(`Телефон: ${p.customer.phone}`);
  if(p.customer.address) lines.push(`Адрес: ${p.customer.address}`);
  lines.push(`Выезд замерщика: ${p.customer.zamer ? 'нужен' : 'не нужен'}`);
  if(p.customer.comment) lines.push(`Комментарий: ${p.customer.comment}`);
  return lines.join('\n');
}

$('#order-form').addEventListener('submit', async e => {
  e.preventDefault();
  const alertEl = $('#form-alert');
  alertEl.hidden = true;
  if(!order.length){
    alertEl.textContent = 'Добавьте в заказ хотя бы одну сетку из конструктора.';
    alertEl.hidden = false;
    return;
  }
  let ok = true, first = null;
  const name = fName.value.trim();
  if(name.length < 2){ setErr(fName, $('#e-name'), 'Укажите имя, чтобы мы знали, как к вам обращаться.'); ok = false; first = first || fName; }
  const ph = digits(fPhone.value);
  if(ph.length !== 11){ setErr(fPhone, $('#e-phone'), 'Введите номер полностью: 11 цифр, например +7 (914) 123-45-67.'); ok = false; first = first || fPhone; }
  const addr = fAddr.value.trim();
  if(addressRequired() && addr.length < 5){ setErr(fAddr, $('#e-address'), 'Укажите адрес: он нужен для замера и установки.'); ok = false; first = first || fAddr; }
  if(!ok){ first.focus(); return; }

  const items = order.map(i => ({ ...i, ...calc(i) }));
  const payload = {
    number: orderNumber(),
    createdAt: new Date().toISOString(),
    items,
    total: items.reduce((s,i) => s + i.total, 0),
    customer: { name, phone: fmtPhone(fPhone.value), address: addr, comment: fComment.value.trim(), zamer: fZamer.checked }
  };

  const btn = $('#submit-btn');
  btn.disabled = true; btn.textContent = 'Отправляем…';
  let res;
  try{
    res = await sendOrder(payload);
  }catch(err){
    alertEl.textContent = 'Заявка не отправилась. Проверьте интернет и нажмите кнопку ещё раз или позвоните нам.';
    alertEl.hidden = false;
    btn.disabled = false; btn.textContent = 'Отправить заявку';
    return;
  }
  const demo = !!(res && res.demo);
  $('#success-num').textContent = demo ? `Заявка ${payload.number} готова` : `Заявка ${payload.number} принята`;
  $('#success-text').textContent = demo
    ? `${items.length} поз. на ${rub(payload.total)}.`
    : `${items.length} поз. на ${rub(payload.total)}. Перезвоним в рабочее время, чтобы сверить размеры.`;
  $('#demo-note').hidden = !demo;
  $('#success-summary').value = summaryText(payload);
  $('#order-form').hidden = true;
  $('#success').hidden = false;
  order = [];
  renderOrder();
  btn.disabled = false; btn.textContent = 'Отправить заявку';
  $('#success-num').setAttribute('tabindex','-1');
  $('#success-num').focus({ preventScroll:false });
});

$('#copy-btn').addEventListener('click', () => {
  const ta = $('#success-summary');
  const done = () => toast('Текст заявки скопирован');
  const fallback = () => { ta.focus(); ta.select(); toast('Текст выделен, скопируйте его'); };
  if(navigator.clipboard && navigator.clipboard.writeText){
    navigator.clipboard.writeText(ta.value).then(done, fallback);
  }else fallback();
});

function resetForm(){
  $('#order-form').reset();
  for(const [inp, err] of [[fName,'#e-name'],[fPhone,'#e-phone'],[fAddr,'#e-address']]) setErr(inp, $(err), '');
  $('#success').hidden = true;
  $('#order-form').hidden = false;
  updateAddressNote();
}
$('#new-btn').addEventListener('click', () => {
  resetForm();
  $('#konstruktor').scrollIntoView({ block:'start' });
});

/* ===== Старт ===== */
renderStatic();
render();
renderOrder();
const anchors = ['konstruktor','zakaz','tipy','kak','voprosy','kontakty'];
const h = (location.hash || '').slice(1);
if(anchors.includes(h)){ const el = document.getElementById(h); if(el) setTimeout(() => el.scrollIntoView({ block:'start' }), 50); }
})();
</script>

