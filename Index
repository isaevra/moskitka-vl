const STORAGE_KEY = 'mosnet-order-v1';

/* ===== Утилиты ===== */
const $  = (s, r=document) => r.querySelector(s);
const $$ = (s, r=document) => Array.from(r.querySelectorAll(s));
const R = n => Math.round(n*100)/100;
const nf = new Intl.NumberFormat('ru-RU');
const fmt = n => nf.format(Math.round(n));
const rub = n => fmt(n) + ' ₽';
const area2 = a => (Math.round(a*100)/100).toLocaleString('ru-RU',{minimumFractionDigits:2,maximumFractionDigits:2});
const round10 = n => Math.round(n/10)*10;
const clamp = (v,a,b) => Math.min(b, Math.max(a, v));
const digits = v => String(v).replace(/\D/g,'');
const cap = s => s.charAt(0).toUpperCase() + s.slice(1);

/* ===== Состояние ===== */
const state = { type:'standard', w:'600', h:'1300', color:'graphite', fastener:'plastic', install:false, qty:1 };
let order = loadOrder();

function loadOrder(){
  try{
    const raw = localStorage.getItem(STORAGE_KEY);
    if(!raw) return [];
    const arr = JSON.parse(raw);
    if(!Array.isArray(arr)) return [];
    return arr.filter(i => i && TYPES[i.type] && COLORS[i.color] && FASTENERS[i.fastener] && i.w > 0 && i.h > 0 && i.qty > 0);
  }catch(e){ return []; }
}
function saveOrder(){
  try{ localStorage.setItem(STORAGE_KEY, JSON.stringify(order)); }catch(e){}
}

function current(){
  const t = TYPES[state.type];
  let w = parseInt(state.w, 10), h = parseInt(state.h, 10);
  const wNum = Number.isFinite(w), hNum = Number.isFinite(h);
  const wOk = wNum && w >= t.w[0] && w <= t.w[1];
  const hOk = hNum && h >= t.h[0] && h <= t.h[1];
  if(!wNum) w = t.def[0];
  if(!hNum) h = t.def[1];
  return {
    type:state.type, color:state.color, fastener:state.fastener, install:state.install, qty:state.qty,
    w:clamp(w, t.w[0], t.w[1]), h:clamp(h, t.h[0], t.h[1]), wOk, hOk
  };
}

function calc(it){
  const t = TYPES[it.type], c = COLORS[it.color];
  const area = it.w * it.h / 1e6;
  const billArea = Math.max(area, t.minArea);
  const net = round10(billArea * t.rate * c.k);
  const fast = it.fastener === 'metal' ? t.metal : 0;
  const inst = it.install ? t.install : 0;
  const unit = net + fast + inst;
  return { area, billArea, minApplied: area < t.minArea, net, fast, inst, unit, total: unit * it.qty };
}

const titleOf = it => `${TYPES[it.type].name}, ${fmt(it.w)} × ${fmt(it.h)} мм`;
const subOf = it => `${COLORS[it.color].name} ${COLORS[it.color].ral}, ${FASTENERS[it.fastener].short}, ${it.install ? 'с установкой' : 'без установки'}`;

/* ===== Рисунок сетки (SVG) ===== */
let uid = 0;
const OPT_MAIN  = { W:560, H:600, L:66, R:24, T:22, B:66, m:18, sw:1.2, mp:4, mw:.55, minPf:5, scene:true, dims:true, r:3 };
const OPT_ICON  = { W:40,  H:48,  L:1,  R:1,  T:1,  B:1,  m:2.5, sw:.7, mp:1.8, mw:.32, minPf:1.6, scene:false, dims:false, r:1 };
const OPT_ART   = { W:160, H:200, L:6,  R:6,  T:6,  B:6,  m:9,  sw:1,  mp:3, mw:.45, minPf:3.2, scene:true, dims:false, r:2 };
const OPT_THUMB = { W:52,  H:60,  L:1,  R:1,  T:1,  B:1,  m:3,  sw:.7, mp:2, mw:.35, minPf:1.8, scene:false, dims:false, r:1 };

function frame(x,y,w,h,pf,col,sw){
  return `<path d="M${R(x)} ${R(y)}h${R(w)}v${R(h)}h${R(-w)}Z M${R(x+pf)} ${R(y+pf)}v${R(h-2*pf)}h${R(w-2*pf)}v${R(-(h-2*pf))}Z" fill="${col}" fill-rule="evenodd" class="ol" stroke-width="${sw}"/>`;
}
function rect(x,y,w,h,fill,sw,rx){
  return `<rect x="${R(x)}" y="${R(y)}" width="${R(w)}" height="${R(h)}"${rx?` rx="${R(rx)}"`:''} fill="${fill}" class="ol" stroke-width="${sw}"/>`;
}
function shade(x,y,w,h,rx){
  return `<rect x="${R(x)}" y="${R(y)}" width="${R(w)}" height="${R(h)}"${rx?` rx="${R(rx)}"`:''} fill="rgba(0,0,0,.22)"/>`;
}
function mesh(x,y,w,h,id){
  if(w <= 0 || h <= 0) return '';
  return `<rect x="${R(x)}" y="${R(y)}" width="${R(w)}" height="${R(h)}" fill="url(#${id}-mesh)"/><rect x="${R(x)}" y="${R(y)}" width="${R(w)}" height="${R(h)}" class="mesh-tint"/>`;
}

const NETS = {
  standard(g){
    const {x,y,nw,nh,s,col,fcol,id,sw,o,it} = g;
    const pf = Math.max(25*s, o.minPf);
    let out = mesh(x+pf, y+pf, nw-2*pf, nh-2*pf, id) + frame(x,y,nw,nh,pf,col,sw);
    if(it.h > 1000) out += rect(x+pf, y+nh/2-pf*.35, nw-2*pf, pf*.7, col, sw);
    // ручки на боковых профилях
    const hw = pf*.5, hh = Math.max(pf*1.9, o.minPf*1.6);
    for(const hx of [x+pf*.25, x+nw-pf*.75]){
      out += rect(hx, y+nh*.74-hh/2, hw, hh, col, sw*.8, hw*.4) + shade(hx, y+nh*.74-hh/2, hw, hh, hw*.4);
    }
    // Z-кронштейны сверху и снизу
    const zw = Math.max(pf*1.5, o.minPf*1.4), zh = Math.max(pf*1.1, o.minPf);
    for(const cx of [x+nw*.22, x+nw*.78]){
      out += rect(cx-zw/2, y-zh*.55, zw, zh, fcol, sw, zh*.2);
      out += rect(cx-zw/2, y+nh-zh*.45, zw, zh, fcol, sw, zh*.2);
    }
    return out;
  },
  vsn(g){
    const {x,y,nw,nh,s,col,fcol,id,sw,o} = g;
    const pf = Math.max(14*s, o.minPf*.7);
    let out = mesh(x+pf, y+pf, nw-2*pf, nh-2*pf, id) + frame(x,y,nw,nh,pf,col,sw);
    // подпружиненные штифты по бокам
    const pl = Math.max(pf*1.1, o.minPf), ph = Math.max(pf*.55, o.minPf*.45), kr = Math.max(pf*.5, o.minPf*.4);
    for(const cy of [y+nh*.2, y+nh*.8]){
      out += rect(x-pl, cy-ph/2, pl+pf*.5, ph, fcol, sw, ph/2);
      out += rect(x+nw-pf*.5, cy-ph/2, pl+pf*.5, ph, fcol, sw, ph/2);
      out += `<circle cx="${R(x+pf*.5)}" cy="${R(cy)}" r="${R(kr)}" fill="${fcol}" class="ol" stroke-width="${sw}"/>`;
      out += `<circle cx="${R(x+nw-pf*.5)}" cy="${R(cy)}" r="${R(kr)}" fill="${fcol}" class="ol" stroke-width="${sw}"/>`;
    }
    // язычок снизу
    const tw = Math.max(pf*3, o.minPf*2.4), th = Math.max(pf*1.2, o.minPf);
    out += rect(x+nw/2-tw/2, y+nh-pf*.3, tw, th, col, sw, th*.3) + shade(x+nw/2-tw/2, y+nh-pf*.3, tw, th, th*.3);
    return out;
  },
  plisse(g){
    const {x,y,nw,nh,s,col,fcol,id,sw,o} = g;
    const pf = Math.max(30*s, o.minPf);
    const iw = nw-2*pf, ih = nh-2*pf, xe = x+pf+iw*.62;
    let out = mesh(x+pf, y+pf, xe-(x+pf), ih, id);
    // складки
    const step = Math.max(o.minPf*1.3, iw*.032);
    let d = '', d2 = '';
    let k = 0;
    for(let px = x+pf+step; px < xe-step*.5; px += step, k++){
      const seg = `M${R(px)} ${R(y+pf)}V${R(y+nh-pf)}`;
      if(k % 2) d2 += seg; else d += seg;
    }
    out += `<path class="pleat" d="${d}" stroke-width="${R(sw*.9)}" fill="none"/>`;
    out += `<path class="pleat" d="${d2}" stroke-width="${R(sw*.5)}" fill="none" opacity=".6"/>`;
    out += frame(x,y,nw,nh,pf,col,sw);
    // подвижный профиль с ручкой
    out += rect(xe-pf*.35, y+pf, pf*.7, ih, col, sw);
    const hh = Math.max(pf*2.6, o.minPf*2);
    out += rect(xe-pf*.18, y+nh/2-hh/2, pf*.36, hh, col, sw*.8, pf*.15) + shade(xe-pf*.18, y+nh/2-hh/2, pf*.36, hh, pf*.15);
    // крепёж
    const zw = Math.max(pf*1.2, o.minPf*1.3), zh = Math.max(pf*.8, o.minPf*.9);
    for(const cx of [x+nw*.15, x+nw*.85]){
      out += rect(cx-zw/2, y-zh*.55, zw, zh, fcol, sw, zh*.2);
      out += rect(cx-zw/2, y+nh-zh*.45, zw, zh, fcol, sw, zh*.2);
    }
    return out;
  },
  door(g){
    const {x,y,nw,nh,s,col,fcol,id,sw,o} = g;
    const pf = Math.max(42*s, o.minPf*1.25);
    let out = mesh(x+pf, y+pf, nw-2*pf, nh-2*pf, id) + frame(x,y,nw,nh,pf,col,sw);
    out += rect(x+pf, y+nh*.48-pf*.4, nw-2*pf, pf*.8, col, sw);
    out += rect(x+pf, y+nh*.8-pf*.3, nw-2*pf, pf*.6, col, sw);
    // петли
    const hw = Math.max(pf*.55, o.minPf*.8), hh = Math.max(pf*1.7, o.minPf*2);
    for(const cy of [y+nh*.12, y+nh*.5, y+nh*.88]){
      out += rect(x-hw*.6, cy-hh/2, hw, hh, fcol, sw, hw*.3);
    }
    // ручка
    const gh = Math.max(pf*3, o.minPf*3);
    out += rect(x+nw-pf*.8, y+nh*.48-gh/2, pf*.45, gh, col, sw*.8, pf*.2) + shade(x+nw-pf*.8, y+nh*.48-gh/2, pf*.45, gh, pf*.2);
    return out;
  }
};

/* Вид из окна: сопки, море и Золотой мост */
function scene(x,y,w,h,sw){
  const hz = y+h*.68, deck = y+h*.64, top = y+h*.33;
  let out = `<path class="v-hill" d="M${R(x)} ${R(hz)}V${R(y+h*.57)}Q${R(x+w*.16)} ${R(y+h*.5)} ${R(x+w*.32)} ${R(y+h*.57)}T${R(x+w*.68)} ${R(y+h*.555)}T${R(x+w)} ${R(y+h*.54)}V${R(hz)}Z"/>`;
  out += `<rect class="v-sea" x="${R(x)}" y="${R(hz)}" width="${R(w)}" height="${R(y+h-hz)}"/>`;
  const a = w*.03;
  let d1 = `M${R(x)} ${R(deck)}H${R(x+w)}`, d2 = '';
  for(const px of [x+w*.3, x+w*.7]){
    d1 += `M${R(px-a)} ${R(hz)}L${R(px)} ${R(top)}L${R(px+a)} ${R(hz)}`;
    for(let k=1; k<=5; k++){
      const dx = k*w*.036, ty = top + h*.025;
      d2 += `M${R(px)} ${R(ty)}L${R(px-dx)} ${R(deck)}M${R(px)} ${R(ty)}L${R(px+dx)} ${R(deck)}`;
    }
  }
  out += `<path class="v-bridge" d="${d1}" stroke-width="${R(Math.max(sw*1.3,1))}"/>`;
  out += `<path class="v-bridge" d="${d2}" stroke-width="${R(Math.max(sw*.55,.5))}" opacity=".8"/>`;
  return out;
}

function dims(x,y,w,h,m,it){
  const yd = y+h+m+22, xd = x-m-22, t = 4;
  const d = [
    `M${R(x)} ${R(y+h+m+5)}V${R(yd+6)}`, `M${R(x+w)} ${R(y+h+m+5)}V${R(yd+6)}`, `M${R(x)} ${R(yd)}H${R(x+w)}`,
    `M${R(x-t)} ${R(yd+t)}L${R(x+t)} ${R(yd-t)}`, `M${R(x+w-t)} ${R(yd+t)}L${R(x+w+t)} ${R(yd-t)}`,
    `M${R(x-m-5)} ${R(y)}H${R(xd-6)}`, `M${R(x-m-5)} ${R(y+h)}H${R(xd-6)}`, `M${R(xd)} ${R(y)}V${R(y+h)}`,
    `M${R(xd-t)} ${R(y+t)}L${R(xd+t)} ${R(y-t)}`, `M${R(xd-t)} ${R(y+h+t)}L${R(xd+t)} ${R(y+h-t)}`
  ].join('');
  const lx = xd-10, ly = y+h/2;
  return `<path class="dim-line" d="${d}" stroke-width="1"/>`
    + `<text class="dim-text" x="${R(x+w/2)}" y="${R(yd+22)}" text-anchor="middle">${fmt(it.w)} мм</text>`
    + `<text class="dim-text" x="${R(lx)}" y="${R(ly)}" text-anchor="middle" transform="rotate(-90 ${R(lx)} ${R(ly)})">${fmt(it.h)} мм</text>`;
}

function drawNet(it, o, label){
  const id = 'n' + (++uid);
  const aw = o.W-o.L-o.R, ah = o.H-o.T-o.B, m = o.m;
  const s = Math.min((aw-2*m)/it.w, (ah-2*m)/it.h);
  const nw = it.w*s, nh = it.h*s;
  const x = o.L + (aw-nw)/2, y = o.T + (ah-nh)/2;
  const col = COLORS[it.color].hex;
  const fcol = it.fastener === 'metal' ? `url(#${id}-mt)` : col;
  const sw = o.sw;
  let svg = `<svg viewBox="0 0 ${o.W} ${o.H}" xmlns="http://www.w3.org/2000/svg"${label ? ` role="img" aria-label="${label}"` : ' aria-hidden="true"'}>`;
  svg += `<defs>`
    + `<linearGradient id="${id}-sky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" style="stop-color:var(--sky-top)"/><stop offset="1" style="stop-color:var(--sky-bottom)"/></linearGradient>`
    + `<linearGradient id="${id}-mt" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#E4E8EA"/><stop offset=".5" stop-color="#99A2A7"/><stop offset="1" stop-color="#CDD3D6"/></linearGradient>`
    + `<pattern id="${id}-mesh" width="${o.mp}" height="${o.mp}" patternUnits="userSpaceOnUse"><path d="M${o.mp} 0H0V${o.mp}" class="mesh-line" fill="none" stroke-width="${o.mw}"/></pattern>`
    + `<clipPath id="${id}-clip"><rect x="${R(x)}" y="${R(y)}" width="${R(nw)}" height="${R(nh)}"/></clipPath>`
    + `</defs>`;
  svg += `<rect class="reveal" x="${R(x-m)}" y="${R(y-m)}" width="${R(nw+2*m)}" height="${R(nh+2*m)}" rx="${o.r}" stroke-width="${sw}"/>`;
  svg += `<g clip-path="url(#${id}-clip)"><rect x="${R(x)}" y="${R(y)}" width="${R(nw)}" height="${R(nh)}" fill="url(#${id}-sky)"/>`;
  if(o.scene) svg += scene(x,y,nw,nh,sw);
  svg += `</g>`;
  svg += NETS[it.type]({x,y,nw,nh,s,col,fcol,id,sw,o,it});
  if(o.dims) svg += dims(x,y,nw,nh,m,it);
  return svg + `</svg>`;
}

