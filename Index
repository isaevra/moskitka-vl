<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 34 34'%3E%3Cpath d='M11 4v26M17 4v26M23 4v26M4 11h26M4 17h26M4 23h26' stroke='%231D6B55' stroke-width='1.6'/%3E%3Crect x='2.5' y='2.5' width='29' height='29' rx='7' fill='none' stroke='%2314211E' stroke-width='3'/%3E%3C/svg%3E">
<style>:root{color-scheme:light;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}body{margin:0}img{max-width:100%}[hidden]{display:none!important}</style>
<title>Москитные сетки на заказ</title>
<meta name="description" content="Конструктор москитных сеток: стандартные, вставные VSN, плиссе и москитные двери. Цена сразу, изготовление и установка во Владивостоке.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600;700&family=Unbounded:wght@500;600&display=swap" rel="stylesheet">
<style>
/* Layout: живое «окно» с сеткой слева (липнет при прокрутке) + панель параметров справа;
   ниже заказ и форма, затем типы, порядок работы, вопросы и контакты. Всё выровнено по левому краю. */
:root{
  --bg:#EDF1EF; --surface:#FFFFFF; --surface-2:#F5F8F6; --ink:#14211E; --muted:#56665F; --line:#D2DBD7;
  --accent:#1D6B55; --accent-hover:#16594A; --accent-ink:#FFFFFF; --accent-soft:#DDEBE5;
  --danger:#B23A2E; --warn:#9A5F06;
  --wall:#E1E7E4; --wall-light:#EAEFEC;
  --sky-top:#C6DDE7; --sky-bottom:#EEF2EA; --sea:#A9C5CC; --hill:#BDD0C9; --bridge:#6B8891;
  --reveal:#F8FAF8; --reveal-edge:#C6D0CC; --mesh:rgba(26,38,35,.5); --mesh-tint:rgba(30,45,42,.07);
  --outline:rgba(20,33,30,.3); --dim:#3E504A;
  --shadow:0 1px 0 rgba(20,33,30,.03), 0 18px 40px -28px rgba(20,33,30,.45);
  --f-display:"Unbounded","Onest",system-ui,sans-serif;
  --f-body:"Onest",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  --r-sm:8px; --r-md:14px; --r-lg:22px;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#0E1513; --surface:#151E1B; --surface-2:#1A2421; --ink:#E3ECE8; --muted:#97A8A2; --line:#283530;
    --accent:#5DC1A0; --accent-hover:#7AD0B3; --accent-ink:#06120E; --accent-soft:#17302A;
    --danger:#F08A7A; --warn:#E3A84A;
    --wall:#18211E; --wall-light:#1E2925;
    --sky-top:#1F2E40; --sky-bottom:#4A566E; --sea:#22353E; --hill:#25323A; --bridge:#8496A3;
    --reveal:#222C29; --reveal-edge:#36443F; --mesh:rgba(6,10,9,.58); --mesh-tint:rgba(0,0,0,.08);
    --outline:rgba(220,235,230,.3); --dim:#B6C5C0;
    --shadow:0 1px 0 rgba(0,0,0,.2), 0 18px 40px -28px rgba(0,0,0,.8);
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#0E1513; --surface:#151E1B; --surface-2:#1A2421; --ink:#E3ECE8; --muted:#97A8A2; --line:#283530;
  --accent:#5DC1A0; --accent-hover:#7AD0B3; --accent-ink:#06120E; --accent-soft:#17302A;
  --danger:#F08A7A; --warn:#E3A84A;
  --wall:#18211E; --wall-light:#1E2925;
  --sky-top:#1F2E40; --sky-bottom:#4A566E; --sea:#22353E; --hill:#25323A; --bridge:#8496A3;
  --reveal:#222C29; --reveal-edge:#36443F; --mesh:rgba(6,10,9,.58); --mesh-tint:rgba(0,0,0,.08);
  --outline:rgba(220,235,230,.3); --dim:#B6C5C0;
  --shadow:0 1px 0 rgba(0,0,0,.2), 0 18px 40px -28px rgba(0,0,0,.8);
  color-scheme:dark;
}

*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
@media (prefers-reduced-motion: no-preference){html{scroll-behavior:smooth}}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--f-body);font-size:16px;line-height:1.5;-webkit-font-smoothing:antialiased}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:60;background:var(--bg)}
a{color:inherit}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}

.wrap{max-width:1200px;margin-inline:auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
@media (min-width:760px){.wrap{padding-left:max(32px,env(safe-area-inset-left,0px));padding-right:max(32px,env(safe-area-inset-right,0px))}}

/* ===== Шапка ===== */
.site-head{position:sticky;top:env(safe-area-inset-top,0px);z-index:50;background:var(--bg);background:color-mix(in srgb,var(--bg) 90%,transparent);-webkit-backdrop-filter:saturate(1.4) blur(12px);backdrop-filter:saturate(1.4) blur(12px);border-bottom:1px solid var(--line)}
.head-row{display:flex;align-items:center;gap:28px;min-height:64px}
.brand{display:flex;align-items:center;gap:10px;text-decoration:none;margin-right:auto;min-width:0}
.brand-mark{width:34px;height:34px;flex:none}
.bm-frame{fill:none;stroke:var(--ink);stroke-width:3}
.bm-mesh{stroke:var(--accent);stroke-width:1.2}
.brand-name{display:block;font-family:var(--f-display);font-weight:600;font-size:15px;line-height:1.15;letter-spacing:-.01em}
.brand-city{display:block;font-size:12.5px;color:var(--muted);font-weight:500;line-height:1.3}
.nav{display:flex;gap:22px}
.nav a{color:var(--muted);text-decoration:none;font-weight:500;font-size:15px;padding-block:6px}
.nav a:hover{color:var(--ink)}
.head-phone{font-weight:600;text-decoration:none;white-space:nowrap;font-variant-numeric:tabular-nums;font-size:15px}
@media (max-width:959px){.nav{display:none}}
@media (max-width:380px){.brand-city{display:none}.head-phone{font-size:14px}}

/* ===== Первый экран ===== */
.hero{padding-block:44px 28px}
.hero-grid{display:grid;gap:16px}
@media (min-width:900px){.hero-grid{grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);align-items:end;gap:40px}}
.hero h1{font-family:var(--f-display);font-weight:600;font-size:clamp(30px,4.6vw,56px);line-height:1.06;letter-spacing:-.03em;margin:0;max-width:15ch;text-wrap:balance}
.hero p{margin:0;font-size:clamp(16px,1.5vw,18px);color:var(--muted);max-width:46ch}

/* ===== Конструктор ===== */
.config-sec{padding-bottom:64px;scroll-margin-top:72px}
.config{display:grid;gap:20px}
@media (min-width:900px){.config{grid-template-columns:minmax(0,1.12fr) minmax(0,1fr);gap:28px;align-items:start}}

.stage{background:radial-gradient(120% 90% at 18% 0%,var(--wall-light),var(--wall) 70%);border:1px solid var(--line);border-radius:var(--r-lg);padding:14px 14px 16px;display:grid;gap:10px}
@media (min-width:900px){.stage{position:sticky;top:calc(env(safe-area-inset-top,0px) + 84px)}}
.stage-art svg{display:block;width:100%;height:auto;max-height:54vh}
@media (min-width:900px){.stage-art svg{max-height:calc(100vh - 230px)}}
.stage-meta{display:flex;flex-wrap:wrap;gap:8px;align-items:center;padding-inline:4px}
.chip{display:inline-flex;align-items:center;gap:7px;padding:5px 11px;border-radius:999px;background:var(--surface);border:1px solid var(--line);font-size:13px;font-weight:500;line-height:1.3}
.chip-accent{background:var(--accent-soft);border-color:transparent;color:var(--ink)}
.chip .dot{width:11px;height:11px;border-radius:50%;box-shadow:inset 0 0 0 1px var(--outline)}
.stage-area{margin-left:auto;font-size:13px;color:var(--muted);font-variant-numeric:tabular-nums}

/* SVG-рисунок */
.reveal{fill:var(--reveal);stroke:var(--reveal-edge)}
.mesh-line{stroke:var(--mesh)}
.mesh-tint{fill:var(--mesh-tint)}
.ol{stroke:var(--outline)}
.pleat{stroke:var(--outline)}
.v-sea{fill:var(--sea)}
.v-hill{fill:var(--hill)}
.v-bridge{stroke:var(--bridge);fill:none;stroke-linecap:round}
.dim-line{stroke:var(--dim);fill:none}
.dim-text{fill:var(--dim);font-family:var(--f-body);font-size:16px;font-weight:600;font-variant-numeric:tabular-nums}

.panel{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-lg);box-shadow:var(--shadow);margin:0}
.field{padding:20px 22px;border-top:1px solid var(--line);display:grid;gap:12px}
.field:first-of-type{border-top:0}
.field-head{display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap}
.field-title{font-size:16px;font-weight:600;margin:0;line-height:1.3}
.field-note{font-size:13px;color:var(--muted);font-variant-numeric:tabular-nums}

.opt-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.opt{position:relative;display:flex;align-items:center;gap:12px;padding:11px 12px;border:1.5px solid var(--line);border-radius:var(--r-md);background:var(--surface);cursor:pointer;transition:border-color .15s,background-color .15s;min-width:0}
.opt:hover{border-color:var(--muted)}
.opt input{position:absolute;opacity:0;width:1px;height:1px;pointer-events:none}
.opt.on{border-color:var(--accent);background:var(--accent-soft)}
.opt.focus{outline:2px solid var(--accent);outline-offset:2px}
.opt-text{display:grid;min-width:0}
.opt-name{font-weight:600;font-size:15px;line-height:1.25}
.opt-sub{font-size:13px;color:var(--muted);font-variant-numeric:tabular-nums;line-height:1.35}
.opt-icon{flex:none;width:40px;height:48px}
.opt-icon svg{display:block;width:100%;height:100%}
.types .opt-sub{white-space:nowrap}
@media (max-width:480px){.types .opt{flex-direction:column;align-items:flex-start;gap:8px}.types .opt-icon{width:34px;height:42px}}

.size-row{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);gap:10px;align-items:end}
.size-x{padding-bottom:13px;color:var(--muted);font-size:18px}
.num label{display:block;font-size:13px;color:var(--muted);margin-bottom:6px}
.num-box{display:flex;align-items:center;border:1.5px solid var(--line);border-radius:var(--r-md);background:var(--surface-2);padding-right:12px;transition:border-color .15s}
.num-box:focus-within{border-color:var(--accent)}
.num-box.warn{border-color:var(--warn)}
.num-box input{flex:1;min-width:0;width:100%;border:0;background:transparent;color:var(--ink);font:600 20px/1.2 var(--f-body);padding:11px 12px;font-variant-numeric:tabular-nums}
.num-box input:focus{outline:none}
.num-box span{color:var(--muted);font-size:14px}
.size-hint{margin:0;font-size:13px;color:var(--muted)}
.size-hint.warn{color:var(--warn);font-weight:500}
.size-tip{margin:0;font-size:14px;color:var(--ink);background:var(--surface-2);border-radius:var(--r-sm);padding:10px 12px}

.sw-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
.sw{flex-direction:column;align-items:stretch;gap:9px}
.sw-bar{display:block;height:30px;border-radius:7px;box-shadow:inset 0 0 0 1px var(--outline);background-image:linear-gradient(180deg,rgba(255,255,255,.22),rgba(255,255,255,0) 45%,rgba(0,0,0,.12))}

.toggle{display:flex;align-items:center;gap:16px;cursor:pointer;position:relative}
.toggle input{position:absolute;opacity:0;width:1px;height:1px}
.switch{margin-left:auto;flex:none;width:50px;height:30px;border-radius:999px;background:var(--line);position:relative;transition:background-color .2s}
.switch::after{content:"";position:absolute;top:3px;left:3px;width:24px;height:24px;border-radius:50%;background:var(--surface);box-shadow:0 1px 3px rgba(0,0,0,.25);transition:transform .2s}
.toggle input:checked + .switch{background:var(--accent)}
.toggle input:checked + .switch::after{transform:translateX(20px)}
.toggle input:focus-visible + .switch{outline:2px solid var(--accent);outline-offset:2px}

.summary{padding:20px 22px 22px;border-top:1px solid var(--line);background:var(--surface-2);border-radius:0 0 var(--r-lg) var(--r-lg);display:grid;gap:14px}
.sum-top{display:flex;align-items:center;gap:16px;flex-wrap:wrap}
.stepper{display:inline-flex;align-items:center;border:1.5px solid var(--line);border-radius:999px;background:var(--surface)}
.stepper button{width:40px;height:40px;border:0;background:transparent;color:var(--ink);font:500 20px/1 var(--f-body);cursor:pointer;border-radius:50%;display:grid;place-items:center}
.stepper button:hover{background:var(--surface-2)}
.stepper output{min-width:3.2ch;text-align:center;font-weight:600;font-variant-numeric:tabular-nums}
.stepper.sm button{width:30px;height:30px;font-size:16px}
.stepper.sm output{min-width:2.6ch;font-size:14px}
.qty-label{font-size:13px;color:var(--muted);display:block;margin-bottom:6px}
.price{margin-left:auto;text-align:right}
.price-total{font-family:var(--f-display);font-weight:600;font-size:30px;letter-spacing:-.02em;line-height:1.1;font-variant-numeric:tabular-nums}
.price-unit{font-size:13px;color:var(--muted);font-variant-numeric:tabular-nums}
.breakdown{display:grid;gap:5px;margin:0;font-size:14px}
.breakdown div{display:flex;justify-content:space-between;gap:16px}
.breakdown dt{color:var(--muted)}
.breakdown dd{margin:0;font-weight:500;font-variant-numeric:tabular-nums;text-align:right;white-space:nowrap}
.sum-note{margin:0;font-size:12.5px;color:var(--muted)}

.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:50px;padding:0 24px;border-radius:999px;border:0;background:var(--accent);color:var(--accent-ink);font:600 16px/1.2 var(--f-body);cursor:pointer;text-decoration:none;transition:background-color .15s,transform .1s}
.btn:hover{background:var(--accent-hover)}
.btn:active{transform:translateY(1px)}
.btn:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
.btn[disabled]{opacity:.45;cursor:not-allowed;transform:none}
.btn-block{width:100%}
.btn-ghost{background:transparent;color:var(--ink);border:1.5px solid var(--line)}
.btn-ghost:hover{background:var(--surface-2);border-color:var(--muted)}

/* ===== Секции ===== */
.section{padding-block:64px;border-top:1px solid var(--line);scroll-margin-top:64px}
.section h2{font-family:var(--f-display);font-weight:600;font-size:clamp(24px,3vw,36px);letter-spacing:-.025em;line-height:1.12;margin:0 0 10px;text-wrap:balance}
.lede{color:var(--muted);margin:0 0 32px;max-width:58ch;font-size:17px}

/* ===== Заказ ===== */
.order-grid{display:grid;gap:24px}
@media (min-width:900px){.order-grid{grid-template-columns:minmax(0,1.12fr) minmax(0,1fr);gap:28px;align-items:start}}
.order-box{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-lg);overflow:hidden}
.order-item{display:grid;grid-template-columns:52px minmax(0,1fr) auto;gap:14px;align-items:center;padding:16px 18px;border-top:1px solid var(--line)}
.order-item:first-child{border-top:0}
.oi-thumb svg{display:block;width:52px;height:60px}
.oi-title{font-weight:600;line-height:1.3}
.oi-sub{font-size:13px;color:var(--muted);line-height:1.4}
.oi-side{display:grid;justify-items:end;gap:8px}
.oi-price{font-weight:600;font-variant-numeric:tabular-nums;white-space:nowrap}
.oi-ctrl{display:flex;align-items:center;gap:6px}
.icon-btn{width:32px;height:32px;border-radius:50%;border:0;background:transparent;color:var(--muted);cursor:pointer;display:grid;place-items:center}
.icon-btn:hover{background:var(--surface-2);color:var(--danger)}
@media (max-width:520px){
  .order-item{grid-template-columns:44px minmax(0,1fr);row-gap:10px}
  .oi-thumb svg{width:44px;height:52px}
  .oi-side{grid-column:1 / -1;display:flex;justify-content:space-between;align-items:center}
}
.order-total{display:flex;justify-content:space-between;align-items:baseline;gap:16px;padding:18px;border-top:1px solid var(--line);background:var(--surface-2)}
.order-total span{color:var(--muted)}
.order-total strong{font-family:var(--f-display);font-weight:600;font-size:24px;letter-spacing:-.02em;font-variant-numeric:tabular-nums}
.order-empty{padding:32px 24px;display:grid;gap:14px;justify-items:start}
.order-empty svg{width:56px;height:64px}
.order-empty p{margin:0;color:var(--muted);max-width:40ch}

.form-card{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-lg);padding:22px;display:grid;gap:16px;box-shadow:var(--shadow)}
.form-card h3{margin:0;font-size:18px;font-weight:600}
.f-field label{display:block;font-weight:500;font-size:14px;margin-bottom:6px}
.f-field label small{color:var(--muted);font-weight:400;font-size:13px}
.f-input{width:100%;border:1.5px solid var(--line);border-radius:var(--r-md);background:var(--surface-2);padding:12px 14px;font:16px/1.4 var(--f-body);color:var(--ink);transition:border-color .15s}
.f-input:focus{outline:none;border-color:var(--accent)}
.f-input.bad{border-color:var(--danger)}
textarea.f-input{resize:vertical;min-height:84px}
.f-err{font-size:13px;color:var(--danger);margin:6px 0 0}
.check{display:flex;gap:10px;align-items:flex-start;cursor:pointer;font-size:15px}
.check input{width:20px;height:20px;margin:1px 0 0;accent-color:var(--accent);flex:none}
.check small{display:block;color:var(--muted);font-size:13px}
.legal{margin:0;font-size:12.5px;color:var(--muted)}
.form-alert{margin:0;padding:10px 12px;border-radius:var(--r-sm);background:var(--surface-2);font-size:14px;color:var(--danger)}

.success{display:grid;gap:14px}
.success-num{font-family:var(--f-display);font-weight:600;font-size:22px;letter-spacing:-.02em;margin:0}
.success p{margin:0;color:var(--muted)}
.success textarea{width:100%;min-height:200px;border:1.5px solid var(--line);border-radius:var(--r-md);background:var(--surface-2);padding:12px 14px;font:14px/1.5 var(--f-body);color:var(--ink);resize:vertical}
.demo-note{font-size:13px;padding:10px 12px;border-radius:var(--r-sm);background:var(--accent-soft);color:var(--ink)}
.row-btns{display:flex;flex-wrap:wrap;gap:10px}

/* ===== Типы ===== */
.types-list{display:grid;gap:32px 24px;grid-template-columns:repeat(4,minmax(0,1fr))}
@media (max-width:959px){.types-list{grid-template-columns:repeat(2,minmax(0,1fr))}}
.type-item{display:grid;align-content:start;gap:0;min-width:0}
.type-art{background:radial-gradient(120% 90% at 18% 0%,var(--wall-light),var(--wall) 70%);border:1px solid var(--line);border-radius:var(--r-md);aspect-ratio:4/5;max-width:100%;padding:8px;display:grid;place-items:center}
.type-art svg{display:block;width:100%;height:100%}
.type-item h3{font-family:var(--f-display);font-weight:600;font-size:18px;letter-spacing:-.015em;margin:16px 0 8px;line-height:1.2}
.type-item p{margin:0 0 12px;color:var(--muted);font-size:15px}
.type-foot{display:flex;flex-wrap:wrap;gap:6px 16px;align-items:baseline}
.type-price{font-weight:600;font-variant-numeric:tabular-nums;font-size:15px}
.link-btn{background:none;border:0;padding:0;color:var(--accent);font:600 15px var(--f-body);cursor:pointer;text-decoration:underline;text-underline-offset:3px;text-decoration-thickness:1.5px}
.link-btn:hover{color:var(--accent-hover)}
@media (max-width:560px){
  .types-list{grid-template-columns:1fr;gap:24px}
  .type-item{grid-template-columns:104px minmax(0,1fr);column-gap:16px}
  .type-art{grid-row:1 / span 3}
  .type-item h3{margin-top:2px}
}

/* ===== Как заказать ===== */
.steps{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:28px;counter-reset:step}
.step{position:relative;padding-top:58px;min-width:0}
.step::before{counter-increment:step;content:counter(step);position:absolute;top:0;left:0;width:42px;height:42px;border-radius:50%;display:grid;place-items:center;background:var(--accent);color:var(--accent-ink);font:600 16px var(--f-display)}
.step::after{content:"";position:absolute;top:21px;left:54px;right:-16px;height:1.5px;background:var(--line)}
.step:last-child::after{display:none}
